programme tableauManip {
            tableau [ 3 ] t1 ;
            tableau [ 2 ] t2 ;
            tableau [ 1 ] t3 ;
            entier i ;
            i := 0 ;
            t3 [ 0 ] := 1 ;
            t2 [ 0 ] := 2 ;
            t2 [ 1 ] := 2 ;
            t1 [ 0 ] := 9 ;
            t1 [ t3 [ i ] ] := t1 [ i ] ;
            t1 [ 2 ] := 3773 ;
            ecrire t1 [ t2 [ t3 [ i ] ] ] ;
            ecrire t1 [ 1 ] ;
            t1 [ 1 ] := 3 ;
            ecrire t1 [ 1 ] ;
            i := 0 ;
            t1 [ i ] := 4 ;
            ecrire t1 [ 0 ] ;
}